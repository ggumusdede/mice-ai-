    "@mice/shared": "*",
    "@simplewebauthn/server": "^11.0.0",
    "exceljs": "^4.4.0",
    "fastify": "^5.12.8",
    "pdfkit": "^0.15.2",
    "pg": "^8.23.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/pdfkit": "^0.17.7",
    "@types/pg": "^8.23.1"
