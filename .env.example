# MICE AI Operations OS — example environment (copy to .env and adjust).
# The apps read process.env; load this file with e.g. `set -a; . ./.env; set +a` or `node --env-file=.env` before starting.
# Never commit real secrets.

# ---------- runtime
NODE_ENV=development
PORT=3001
HOST=0.0.0.0

# ---------- database (PostgreSQL 16) — the API MUST connect as the non-superuser role mice_app (RLS)
DATABASE_URL=postgres://mice_app:mice_app@localhost:5432/mice
# owner / superuser connection: migrations and seed only
MIGRATION_DATABASE_URL=postgres://postgres@localhost:5432/mice

# ---------- security (required in production)
JWT_SECRET=change-me-to-a-long-random-string-of-32-plus-chars
# session lifetime (legacy name JWT_EXPIRES_IN still read); sessions are revocable via users.token_version (G-17)
JWT_TTL=8h
# pgcrypto key for guest PII (rooming list names / e-mail / phone); never stored in the database
GUEST_DATA_KEY=change-me-guest-data-key
# {biometric:{method:'dev'}} is accepted only when NODE_ENV!=='production' or this is 1 (demo / e2e only)
ALLOW_DEV_BIOMETRIC=
# WebAuthn (Face ID step-up for money / contract / quote approvals)
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=MICE AI Operations OS
WEBAUTHN_ORIGIN=http://localhost:5173

# ---------- web / public links
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
# prefix of supplier (/s/rfq/<token>), quote (/q/<token>), rooming (/r/<token>), extra (/e/<token>), survey (/survey/<token>) links
PUBLIC_BASE_URL=http://localhost:5173
PUBLIC_RATE_LIMIT=60
# POST /api/auth/login attempts per minute per IP (brute force)
LOGIN_RATE_LIMIT=20
# multi-instance API: shared rate-limit store (needs the optional package: npm i ioredis -w apps/api); empty → per-instance memory
RATE_LIMIT_REDIS_URL=
# XLSX zip-bomb guard (offers, invoices, bank statements; G-18)
XLSX_MAX_UNCOMPRESSED_MB=30
XLSX_MAX_RATIO=100
XLSX_MAX_ENTRIES=2000

# ---------- AI (Claude) — without a key (or with AI_PROVIDER=mock) the deterministic mock is used
ANTHROPIC_API_KEY=
AI_PROVIDER=mock
AI_MODEL=claude-sonnet-5-5
AI_MODEL_FAST=claude-haiku-5-5
AI_MAX_RETRIES=3
AI_TIMEOUT_MS=120000
# 'off' disables the server-side refusal fallback
AI_FALLBACKS=
# 'false' never sends PDFs / images to the model (KVKK)
AI_ALLOW_BINARY_DOCS=

# ---------- worker / documents
WORKER_INTERVAL_MS=300000
# Unicode TTF fonts for Turkish characters in PDFs (DejaVu / Liberation are picked up automatically when installed)
PDF_FONT_PATH=
PDF_FONT_BOLD_PATH=

# ---------- deployment / ops
# JSON logs (pino): trace | debug | info | warn | error. Authorization / cookies / PII keys and public link tokens are redacted.
LOG_LEVEL=info
# behind nginx / a load balancer: '1' trusts X-Forwarded-* (real client IP for rate limits), or a list of proxy CIDRs.
# Leave empty when the API is reachable directly.
TRUST_PROXY=
# graceful shutdown: hard exit after this many ms (API 15000, worker 30000 by default)
SHUTDOWN_TIMEOUT_MS=
# migrate step (docker `migrate` / `npm run migrate:deploy -w apps/api`): sets the mice_app role password (owner connection).
# Then DATABASE_URL above must use the same password: postgres://mice_app:<APP_DB_PASSWORD>@host:5432/mice
APP_DB_PASSWORD=
# docker entrypoint `serve`: run migrations before starting (single-instance setups; compose uses a one-shot migrate service)
MIGRATE_ON_START=0
# docker-compose only: postgres superuser password and published web port
POSTGRES_PASSWORD=
WEB_PORT=8080
# scripts/backup.sh (owner connection; defaults to MIGRATION_DATABASE_URL), target dir, retention, optional GPG recipient
BACKUP_DATABASE_URL=
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=14
BACKUP_GPG_RECIPIENT=

# ---------- e-mail (§3.3: always sent FROM the responsible user's own address)
# outbox = record only (default, dev) | smtp = real delivery via nodemailer (outbox row kept for audit)
EMAIL_PROVIDER=outbox
# immediate = try SMTP inside the request (failures → worker retry) | queue = the worker delivers
EMAIL_SEND_MODE=immediate
SMTP_HOST=
SMTP_PORT=587
# true for implicit TLS (465); default: true only when SMTP_PORT=465 (587 uses STARTTLS)
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
# optional envelope sender / Sender: header (bounce address) — From stays the user's address
SMTP_ENVELOPE_FROM=
SMTP_TLS_REJECT_UNAUTHORIZED=true
SMTP_CONNECTION_TIMEOUT_MS=10000
SMTP_SOCKET_TIMEOUT_MS=20000
# shared reply mailbox, plus-addressed per project (replies+prj-0042@agency.com) and added to Reply-To next to the sender
EMAIL_REPLY_ADDRESS=
# right-hand side of Message-ID (<outbox-id@domain>); defaults to the EMAIL_REPLY_ADDRESS domain
EMAIL_MESSAGE_ID_DOMAIN=
EMAIL_MAX_ATTEMPTS=8
# pgcrypto key for the retry copy of unsent e-mails (contains one-time links until delivered); defaults to GUEST_DATA_KEY
OUTBOX_DATA_KEY=

# ---------- SMS / WhatsApp (field-extra approval links) — outbox only in this phase; whatsapp_cloud is a skeleton (not live)
MESSAGING_PROVIDER=outbox
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TOKEN=
WHATSAPP_API_VERSION=v21.0
# inbound WhatsApp webhook (GET/POST /api/inbound/whatsapp): Meta app secret (X-Hub-Signature-256), verify token for the
# subscription handshake; WHATSAPP_PHONE_NUMBER_ID above → this tenant slug when no inbound_channels(whatsapp) row exists
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_TENANT=demo
WHATSAPP_MAX_BYTES=1048576

# ---------- Inbound e-mail (§7 Adım 0 / Adım 1 yanıt okuma) — POST /api/inbound/email/<tenant-slug|route-key>[/postmark|/mailgun|/mime]
# Per-tenant secrets: POST /api/inbound-channels {channel:'email'} (admin, returned once). The env secret below is ONLY a
# fallback for the tenant INBOUND_EMAIL_TENANT (demo). Signature: X-MICE-Timestamp + X-MICE-Signature: sha256=HMAC(secret, "ts.body")
INBOUND_EMAIL_SECRET=
INBOUND_EMAIL_TENANT=demo
INBOUND_REPLAY_WINDOW_SECONDS=300
INBOUND_EMAIL_MAX_BYTES=26214400
INBOUND_ATTACHMENT_MAX_BYTES=10485760
INBOUND_MAX_ATTACHMENTS=10
INBOUND_ATTACHMENTS_TOTAL_MAX_BYTES=20971520
INBOUND_RATE_LIMIT=300
# webhook (default) | imap → `npm run inbound:imap -w apps/api` polls one mailbox with the same router
INBOUND_EMAIL_MODE=webhook
IMAP_HOST=
IMAP_PORT=993
IMAP_SECURE=true
IMAP_USER=
IMAP_PASS=
IMAP_MAILBOX=INBOX
# optional: move processed mails here (else only flagged \Seen)
IMAP_PROCESSED_MAILBOX=
IMAP_TENANT=demo
IMAP_POLL_INTERVAL_MS=60000
IMAP_MAX_MESSAGES_PER_POLL=50

# ---------- Web Push (§15) — generate once: npm run vapid:generate -w apps/api. Empty → console fallback (notifications table only)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ops@your-agency.example
# endpoint hosts the API may send to (SSRF guard, suffix match); default: FCM, Mozilla, Apple, Windows push services
WEB_PUSH_ALLOWED_HOSTS=
# 1 → generic title/body only (no project details through the browser vendor's push service)
WEB_PUSH_MINIMAL_PAYLOAD=
WEB_PUSH_TTL_SECONDS=86400
WEB_PUSH_TIMEOUT_MS=5000
