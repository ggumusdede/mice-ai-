# MICE AI Operations OS — example environment (copy to .env and adjust).
# The apps read process.env; load this file with e.g. `set -a; . ./.env; set +a` or `node --env-file=.env` before starting.
# Never commit real secrets.

# ---------- runtime
NODE_ENV=development
PORT=3001
HOST=0.0.0.0

# ---------- database (PostgreSQL 16) — the API MUST connect as the non-superuser role mice_app (RLS)
DATABASE_URL=postgres://mice_app:mice_app@localhost:5432/mice
# owner / superuser connection: migrations and seed only
MIGRATION_DATABASE_URL=postgres://postgres@localhost:5432/mice

# ---------- security (required in production)
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=12h
# pgcrypto key for guest PII (rooming list names / e-mail / phone); never stored in the database
GUEST_DATA_KEY=change-me-guest-data-key
# {biometric:{method:'dev'}} is accepted only when NODE_ENV!=='production' or this is 1 (demo / e2e only)
ALLOW_DEV_BIOMETRIC=
# WebAuthn (Face ID step-up for money / contract / quote approvals)
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=MICE AI Operations OS
WEBAUTHN_ORIGIN=http://localhost:5173

# ---------- web / public links
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
# prefix of supplier (/s/rfq/<token>), quote (/q/<token>), rooming (/r/<token>), extra (/e/<token>), survey (/survey/<token>) links
PUBLIC_BASE_URL=http://localhost:5173
PUBLIC_RATE_LIMIT=60
# POST /api/auth/login attempts per minute per IP (brute force)
LOGIN_RATE_LIMIT=20

# ---------- AI (Claude) — without a key (or with AI_PROVIDER=mock) the deterministic mock is used
ANTHROPIC_API_KEY=
AI_PROVIDER=mock
AI_MODEL=claude-sonnet-5-5
AI_MODEL_FAST=claude-haiku-5-5
AI_MAX_RETRIES=3
AI_TIMEOUT_MS=120000
# 'off' disables the server-side refusal fallback
AI_FALLBACKS=
# 'false' never sends PDFs / images to the model (KVKK)
AI_ALLOW_BINARY_DOCS=

# ---------- worker / documents
WORKER_INTERVAL_MS=300000
# Unicode TTF fonts for Turkish characters in PDFs (DejaVu / Liberation are picked up automatically when installed)
PDF_FONT_PATH=
PDF_FONT_BOLD_PATH=
